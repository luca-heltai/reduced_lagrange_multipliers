set dimension         = 2
set space dimension   = 2
set reduced dimension = 1

subsection Functions
  subsection Dirichlet boundary conditions 0
    # Spatial displacement amplitude: x = 1, y = 0.
    # Frequency and sine phase are specified below.
    set Function expression  = 0; 0.001
    set Modulation frequency = 0
    set Phase shift          = 0
    set Variable names       = x,y,t
  end
end

subsection Immersed Problem
  set Dirichlet boundary ids             = 0
  set FE degree                          = 1
  set Initial refinement                 = 6
  set Neumann boundary ids               =
  set Normal flux boundary ids           =
  set Output directory                   = output/square_freq/
  set Output name                        = solution_elasticity_freq_50Hz
  set Rhs material ids                   =

  subsection Frequency domain
    set Frequencies                    = 50
    set Dirichlet phase                 = -90
    set Neumann phase                   = 0
    set Rhs phase                       = 0
    set Dirichlet phase by boundary id  =
    set Neumann phase by boundary id    =
    set Rhs phase by material id        =
    set GMRES basis size                = 100
  end

  subsection Grid generation
    set Domain type              = generate
    set Grid generator           = hyper_cube
    set Grid generator arguments = 0:0.1:true
    set Grid scale               = 1
    set Triangulation type       = distributed
  end

  subsection Material properties
    
    subsection default
      set Density        = 1000
      set Lame lambda    = 0
      set Lame mu        = 2000
      set Rayleigh alpha = 0
      set Rayleigh beta  = 0
      set Viscosity eta  = 2
    end

  end

  subsection Refinement and remeshing
    set Coarsening fraction         = 0
    set Maximum number of cells     = 20000
    set Number of refinement cycles = 1
    set Refinement fraction         = 0.3
    set Strategy                    = global
  end

end

subsection Solvers
  subsection Displacement
    set Log frequency = 1
    set Log history   = false
    set Log result    = true
    set Max steps     = 3000
    set Reduction     = 1.e-7
    set Tolerance     = 1.e-7
  end

end

# Exercise failures using the real compiled registry, not a second inventory.
file(READ "${CATEGORY_FILE}" _categories)
file(MAKE_DIRECTORY "${TEST_OUTPUT_DIR}")
foreach(_kind ordinary typed parameterized)
  if(_kind STREQUAL "ordinary")
    set(_pattern LiftedIntegrationSupport)
    set(_overlap LiftedIntegrationSupport*)
    set(_extra_category UNIT)
    set(_suite_regex LiftedIntegrationSupport)
  elseif(_kind STREQUAL "typed")
    set(_pattern TestCategoryTyped/*)
    set(_overlap TestCategoryTyped/?)
    set(_extra_category INTEGRATION)
    set(_suite_regex TestCategoryTyped/)
  elseif(_kind STREQUAL "parameterized")
    set(_pattern TriangulationBackendsValidation/*)
    set(_overlap TriangulationBackendsValidation/*TriangulationTypeTest)
    set(_extra_category UNIT)
    set(_suite_regex TriangulationBackendsValidation/)
  endif()

  foreach(_case missing overlap duplicate)
    if(_case STREQUAL "missing")
      string(REPLACE "    ${_pattern}\n" "" _fixture "${_categories}")
      if(_fixture STREQUAL _categories)
        message(FATAL_ERROR "Missing-category fixture did not remove ${_pattern}")
      endif()
      set(_expected "matches 0 categories")
    elseif(_case STREQUAL "overlap")
      set(_fixture "${_categories}\nlist(APPEND IMMERSX_${_extra_category}_TEST_SUITES ${_overlap})\n")
      set(_expected "matches 2 categories")
    elseif(_case STREQUAL "duplicate")
      set(_fixture "${_categories}\nlist(APPEND IMMERSX_${_extra_category}_TEST_SUITES ${_pattern})\n")
      set(_expected "matches 2 categories")
    endif()
    set(_file "${TEST_OUTPUT_DIR}/${_kind}-${_case}.cmake")
    file(WRITE "${_file}" "${_fixture}")
    execute_process(
      COMMAND "${CMAKE_COMMAND}" "-DTEST_EXECUTABLE=${TEST_EXECUTABLE}"
              "-DCATEGORY_FILE=${_file}"
              -P "${CMAKE_CURRENT_LIST_DIR}/check_test_categories.cmake"
      RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr
      TIMEOUT 30)
    string(REGEX REPLACE "[ \t\r\n]+" " " _diagnostic "${_stderr}")
    if(_result STREQUAL "0" OR NOT _diagnostic MATCHES "${_expected}" OR
       NOT _diagnostic MATCHES "${_suite_regex}")
      message(FATAL_ERROR "Category guard did not detect ${_kind} ${_case}: ${_stdout}\n${_stderr}")
    endif()
  endforeach()
endforeach()
message(STATUS "Category guard rejected all ordinary, typed, and parameterized fixtures")

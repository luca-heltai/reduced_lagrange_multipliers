set dimension = 2
set space dimension = 2

subsection Lifted elasticity
  set Coupling = none
  subsection Refinement
    set Number of refinement cycles = 2
  end
  set Refinement strategy = fixed_fraction
  set Refinement fraction = 0.5
  set Output directory = @TEST_OUTPUT_DIR@/lifted_elasticity/uncoupled_2d
  subsection Displacement space
    set Finite element = FESystem[FE_Q(2)^2]
  end
  subsection Domain
    set Initial refinement = 2
    set Triangulation type = distributed
  end
  subsection Functions
    subsection Right hand side
      set Function expression = 1; -2
    end
  end
end
